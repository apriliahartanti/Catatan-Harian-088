<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg_088"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvFormTitle088"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tulis Catatan"
            android:textColor="@color/text_main_088"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Abadikan cerita dan pengalamanmu hari ini."
            android:textColor="@color/text_secondary_088"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_088"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Catatan"
                android:textColor="@color/text_main_088"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoteTitle088"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_088"
                android:hint="Masukkan judul catatan"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="@color/text_main_088"
                android:textColorHint="@color/text_secondary_088"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Isi Catatan"
                android:textColor="@color/text_main_088"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoteContent088"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_088"
                android:gravity="top|start"
                android:hint="Ceritakan kegiatan atau pengalamanmu hari ini..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/text_main_088"
                android:textColorHint="@color/text_secondary_088"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveNote088"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_button_088"
                android:backgroundTint="@null"
                android:text="Simpan Catatan"
                android:textAllCaps="false"
                android:textColor="@color/white_088"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
