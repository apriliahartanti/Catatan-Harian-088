<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg_088"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATATAN HARIAN"
                android:textColor="@color/blue_dark_088"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome088"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Halo, Pengguna!"
                android:textColor="@color/text_main_088"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLogout088"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_input_088"
            android:backgroundTint="@null"
            android:text="Keluar"
            android:textAllCaps="false"
            android:textColor="@color/blue_dark_088"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tuliskan hal-hal berharga dalam harimu."
        android:textColor="@color/text_secondary_088"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAddNote088"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_button_088"
        android:backgroundTint="@null"
        android:text="+  Tambah Catatan Baru"
        android:textAllCaps="false"
        android:textColor="@color/white_088"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:text="Catatan Saya"
        android:textColor="@color/text_main_088"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmpty088"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:gravity="center"
        android:text="Belum ada catatan.\nYuk, buat cerita pertamamu!"
        android:textColor="@color/text_secondary_088"
        android:textSize="14sp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes088"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
